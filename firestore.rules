rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isValidListingStatus(status) {
      return status in ['published', 'draft', 'reserved', 'sold', 'expired', 'available'];
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId) && !('admin' in request.resource.data);
      allow delete: if isAdmin();
    }

    // 2. Listing Collections
    match /{listingCollection}/{listingId} {
      allow read: if listingCollection in ['ads', 'properties', 'property', 'cars', 'bikes', 'mobiles', 'electronics', 'furniture', 'others'];
      
      allow create: if isAuthenticated()
        && listingCollection in ['ads', 'properties', 'property', 'cars', 'bikes', 'mobiles', 'electronics', 'furniture', 'others']
        && request.resource.data.sellerId == request.auth.uid
        && isValidListingStatus(request.resource.data.status);
        
      allow update: if (isAuthenticated() && resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == request.auth.uid && isValidListingStatus(request.resource.data.status))
        || isAdmin();
        
      allow delete: if (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isAdmin();
    }

    // 3. Chats Collection
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.sellerId || 
        request.auth.uid == resource.data.buyerId ||
        (resource.data.keys().hasAll(['participants']) && request.auth.uid in resource.data.participants)
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.sellerId == request.auth.uid || 
        request.resource.data.buyerId == request.auth.uid ||
        (request.resource.data.keys().hasAll(['participants']) && request.auth.uid in request.resource.data.participants)
      );
      
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.sellerId || 
        request.auth.uid == resource.data.buyerId ||
        (resource.data.keys().hasAll(['participants']) && request.auth.uid in resource.data.participants)
      ) && request.resource.data.sellerId == resource.data.sellerId && request.resource.data.buyerId == resource.data.buyerId;
      
      allow delete: if isAdmin();

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid && (
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow update: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
      }
    }

    // 4. Global Messages Collection
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 5. Saved Ads / Favorites
    match /savedAds/{savedId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 6. Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid && request.resource.data.reviewerId != request.resource.data.targetUserId;
      allow update, delete: if isAdmin();
    }

    // 7. Reports
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAdmin();
      allow update, delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // 9. Drafts
    match /drafts/{draftId} {
      allow read, write, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 10. Blocked Users
    match /blockedUsers/{blockId} {
      allow read, write, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 11. Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Admin Logs
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
